# Copy to .env. Shell variables override these. All optional.
# Models are bare Anthropic ids; the executor, improver and judge are all `claude -p`.
HARNESS2_EXECUTOR_MODEL=claude-opus-5-5
HARNESS2_EXECUTOR_EFFORT=
HARNESS2_IMPROVER_MODEL=claude-opus-5-5
HARNESS2_IMPROVER_EFFORT=high
# Per improver session; 0 = no --max-budget-usd. The cap is checked between turns and can be
# overshot; a session that hits it is a failed session (retried once, then the stage falls back).
HARNESS2_IMPROVER_MAX_BUDGET_USD=25
HARNESS2_JUDGE_MODEL=claude-opus-5-5
HARNESS2_RUNS_DIR=runs
HARNESS2_TASKS_DIR=tasks
HARNESS2_CLAUDE_BIN=claude
HARNESS2_PHASE_WIDTH=2
HARNESS2_PROPOSER_CONCURRENCY=2
HARNESS2_TRANSPORT_ATTEMPTS=2
